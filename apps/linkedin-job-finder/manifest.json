{
  "manifest_version": 3,
  "name": "LinkedIn Job Finder",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "description": "Compare the open LinkedIn job with your local keyword rules and save matching roles.",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LinkedIn Job Finder"
  },
  "options_ui": {
    "page": "src/saved/saved.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
