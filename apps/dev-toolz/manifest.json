{
  "manifest_version": 3,
  "name": "Dev Toolz",
  "version": "1.1.22",
  "minimum_chrome_version": "118",
  "description": "Persistent API and media traffic inspection for developers",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    },
    "default_title": "Dev Toolz"
  },
  "devtools_page": "src/devtools/devtools-page.html",
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "debugger"],
  "web_accessible_resources": [
    {
      "resources": ["public/register-panel.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
