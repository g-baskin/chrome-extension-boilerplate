{
  "name": "chrome-extensions",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for Chrome extensions and shared packages",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @chrome-extensions/dev-toolz",
    "dev:dev-toolz": "npm run dev --workspace @chrome-extensions/dev-toolz",
    "build": "npm run build --workspaces --if-present",
    "build:dev-toolz": "npm run build --workspace @chrome-extensions/dev-toolz",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "author": {
    "name": "Greg Baskin",
    "url": "https://backroomsoftware.com"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/g-baskin/chrome-extension-boilerplate"
  },
  "keywords": [
    "chrome-extension",
    "monorepo",
    "manifest-v3",
    "typescript",
    "vite",
    "react"
  ]
}
